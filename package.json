{
  "name": "article-db",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/pg": "^8.18.0",
    "@upstash/redis": "^1.34.9",
    "dotenv": "^17.3.1",
    "jose": "^6.1.3",
    "js-yaml": "^4.1.0",
    "lru-cache": "^11.2.2",
    "lucide-react": "^0.577.0",
    "next": "^15.2.4",
    "pg": "^8.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  }
}
