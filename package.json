{
  "name": "news-mono",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.1",
  "description": "AI 新闻系统 monorepo：article-db（数据上游）+ ai-news（消费层）+ cli（agent 入口）",
