{
  "name": "extraction-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx --env-file=.env watch src/index.ts",
    "install:chromium": "playwright install chromium",
    "xhs-login": "tsx --env-file=.env src/xhs-login.ts",
    "xhs-keep-alive": "tsx --env-file=.env src/xhs-keep-alive.ts",
    "ig-login": "tsx --env-file=.env src/ig-login.ts",
    "ig-keep-alive": "tsx --env-file=.env src/ig-keep-alive.ts",
    "server": "tsx --env-file=.env src/index.ts --server",
    "server-poll": "tsx --env-file=.env src/index.ts --server --poll"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "playwright": "^1.58.2",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
