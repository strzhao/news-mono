# article-db 环境变量模板
# 复制为 .env.local 后填入实际值

# === 必须 ===
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DEEPSEEK_API_KEY="sk-xxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# === 认证 ===
# AUTH_ISSUER="https://user.example.com"
# AUTH_AUDIENCE="base-account-client"
# AUTH_EMAIL_ALLOWLIST="user@example.com"
# AUTH_JWKS_URL="https://user.example.com/.well-known/jwks.json"

# === 运行时 ===
CRON_SECRET="your-cron-secret"
ARTICLE_DB_API_TOKEN="your-api-token"
RSSHUB_BASE_URL="https://your-rsshub-instance"
# BROWSER_EXTRACT_URL="http://localhost:3100"

# === 缓存 ===
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxx"

# === Vercel Blob ===
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# === AI 评估参数 ===
AI_EVAL_PROMPT_VERSION="v7"
MAX_EVAL_ARTICLES="50"
MIN_WORTH_READING_SCORE="58"
MIN_HIGHLIGHT_SCORE="62"
HIGHLIGHT_DYNAMIC_PERCENTILE="70"
HIGHLIGHT_MIN_COUNT="8"
HIGHLIGHT_SELECTION_RATIO="1.0"
MIN_HIGHLIGHT_CONFIDENCE="0.55"

# === 内容抓取 ===
HQ_CONTENT_CRAWL_ENABLED="true"
HQ_CONTENT_CRAWL_CONCURRENCY="3"
HQ_CONTENT_CRAWL_LIMIT="20"
HQ_CONTENT_CRAWL_TIMEOUT_MS="8000"
HQ_CONTENT_CRAWL_MAX_HTML_BYTES="1500000"
HQ_CONTENT_CRAWL_MAX_TEXT_CHARS="120000"
HQ_CONTENT_CRAWL_MAX_IMAGES="24"

# === 摘要与去重 ===
DIGEST_TIMEZONE="Asia/Shanghai"
MAX_INFO_DUP_PER_DIGEST="2"
MIN_FETCH_PER_SOURCE="1"
INGESTION_EVAL_ESTIMATE_PER_ARTICLE_MS="2000"
